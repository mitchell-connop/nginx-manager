# Copy to .env (install.sh does this for you). Never commit .env.
PORT=3000

# REQUIRED — install.sh generates a random value.
SESSION_SECRET=change-me-to-something-random

# REQUIRED — the login password, ideally as a bcrypt hash (install.sh stores a hash).
# Generate one with: node -e "console.log(require('bcryptjs').hashSync(process.argv[1], 12))" 'YourPassword'
ADMIN_PASSWORD=change-me

# NGINX Agent gRPC listener (TLS). Agents connect in to this port.
GRPC_PORT=8443
# Hostname/IP agents use to reach this manager (shown in the agent setup instructions).
# Defaults to the hostname you browse the UI with.
#AGENT_CONNECT_HOST=nginx-manager.example.lan
# Extra names/IPs for the auto-generated gRPC server certificate (comma separated).
# Defaults to this host's hostname and IPv4 addresses.
#GRPC_TLS_SANS=DNS:nginx-manager.example.lan,IP:172.16.40.10
# Or bring your own certificate:
#GRPC_TLS_CERT=/path/to/server.pem
#GRPC_TLS_KEY=/path/to/server.key
#GRPC_TLS_CA=/path/to/ca.pem

# Set when the UI is served over HTTPS (e.g. behind a reverse proxy).
#COOKIE_SECURE=true
#TRUST_PROXY=1
