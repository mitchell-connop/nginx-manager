[Unit]
Description=Nginx Manager — Web GUI + NGINX Agent management plane
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=root
WorkingDirectory=/opt/nginx-manager
EnvironmentFile=/opt/nginx-manager/.env
ExecStart=/usr/bin/node /opt/nginx-manager/server.js
Restart=always
RestartSec=5
StandardOutput=journal
StandardError=journal

# Hardening — the manager only needs to write its own data directory
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
ReadWritePaths=/opt/nginx-manager/data
UMask=0077

[Install]
WantedBy=multi-user.target
